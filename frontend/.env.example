# API Flask (développement local : npm start)
REACT_APP_API_BASE=http://localhost:5000

# Grafana — monitoring technique (complément Power BI)
REACT_APP_GRAFANA_URL=http://localhost:3030

# --- Admin : rapport complet (hedha howa.pbix) ---
REACT_APP_POWERBI_REPORT_ID=61479adc-ac20-4514-b0c4-4002aa90db0b
REACT_APP_POWERBI_VIEW_URL=https://app.powerbi.com/groups/me/reports/61479adc-ac20-4514-b0c4-4002aa90db0b?experience=power-bi
# REACT_APP_POWERBI_WORKSPACE_ID=

# --- Superviseur (recommandé) : 2e rapport publié avec SEULEMENT pages 3 et 5 ---
# Power BI Desktop : Enregistrer sous → supprimer pages 1,2,4 → Publier → copier le nouvel ID :
# REACT_APP_POWERBI_SUPERVISOR_REPORT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sinon : IDs de page (ouvrir page 3 sur app.powerbi.com, copier le segment d’URL après /reports/.../)
REACT_APP_POWERBI_SUPERVISOR_PAGE_3_NAME=Page 3
REACT_APP_POWERBI_SUPERVISOR_PAGE_5_NAME=Page 5
REACT_APP_POWERBI_SUPERVISOR_PAGE_3_ID=05287cbe65717a5f3a86
