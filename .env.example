# Copier vers .env et remplir les valeurs

# --- Messagerie intelligente (OpenRouter — pas Gemini/Groq/OpenAI direct) ---
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_APP_URL=http://localhost:3000
# OPENROUTER_APP_NAME=FactuPRO

# --- Assistant IA (Gemini) — quota gratuit ~5 req/min : 1 appel/question par défaut ---
GEMINI_API_KEY=
# GEMINI_MODEL=models/gemini-2.5-flash
# GEMINI_MIN_INTERVAL_SEC=13
# GEMINI_QA_EXTRA_CALLS=0

# --- Transcription vocale (micro) : Groq recommandé ---
GROQ_API_KEY=
# Modèles Groq : whisper-large-v3-turbo (défaut) ou whisper-large-v3
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# auto = Groq si GROQ_API_KEY, sinon OpenAI | groq | openai
# TRANSCRIPTION_PROVIDER=auto

# --- Power BI (superviseur : pages 3 et 5) — optionnel, sinon config via /admin/powerbi-setup ---
# POWERBI_REPORT_ID=61479adc-ac20-4514-b0c4-4002aa90db0b
POWERBI_PAGE_3_ID=05287cbe65717a5f3a86
POWERBI_PAGE_5_ID=292cfcb5017d08238b85

# --- Actualisation automatique du dataset après facture / correction (API Power BI) ---
# Prérequis : App Azure AD + dataset dans un espace de travail (pas seulement « Mon espace » perso)
# POWERBI_AUTO_REFRESH=1
# POWERBI_TENANT_ID=votre-tenant-id-azure
# POWERBI_CLIENT_ID=votre-client-id-app-registration
# POWERBI_CLIENT_SECRET=votre-secret
# POWERBI_DATASET_ID=cc93fdbe-f8ab-48bd-b9b1-bc701f34c4ca
# POWERBI_WORKSPACE_ID=guid-espace-de-travail
# POWERBI_REFRESH_MIN_INTERVAL_SEC=30

# --- OpenAI : TTS (lecture réponse) et/ou transcription si pas de Groq ---
OPENAI_API_KEY=
# TTS : tts-1 (défaut, moins cher) ou tts-1-hd ou gpt-4o-mini-tts
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova
# OPENAI_WHISPER_MODEL=whisper-1
