# Copier vers .env et remplir les valeurs

# --- Transcription vocale (micro) : recommandé Groq (quota séparé, évite 429 OpenAI) ---
GROQ_API_KEY=
# Modèles Groq : whisper-large-v3-turbo (défaut) ou whisper-large-v3
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# auto = Groq si GROQ_API_KEY, sinon OpenAI | groq | openai
# TRANSCRIPTION_PROVIDER=auto

# --- OpenAI : TTS (lecture réponse) et/ou transcription si pas de Groq ---
OPENAI_API_KEY=
# TTS : tts-1 (défaut, moins cher) ou tts-1-hd ou gpt-4o-mini-tts
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova
# OPENAI_WHISPER_MODEL=whisper-1
